// Prisma Schema for CareerLaunch
// Local dev: SQLite (DATABASE_URL="file:./dev.db")
// Production: PostgreSQL (DATABASE_URL="postgresql://...")

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = env("DATABASE_PROVIDER")
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  role         String   @default("STUDENT") // STUDENT, COMPANY, TNP, MENTOR, ADMIN
  status       String   @default("ACTIVE")  // ACTIVE, INACTIVE, PENDING
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  studentProfile StudentProfile?
  companyProfile CompanyProfile?
  mentorProfile  MentorProfile?
  notifications  Notification[]
  auditLogs      AuditLog[]
  documents      Document[]
}

model StudentProfile {
  id                 String   @id @default(uuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  studentCode        String   @unique
  fullName           String
  department         String
  passingYear        Int
  cgpa               Float
  backlogs           Int      @default(0)
  bio                String?
  phone              String?
  address            String?
  linkedinUrl        String?
  githubUrl          String?
  portfolioUrl       String?
  resumeDocumentId   String?
  preferredDomains   String?  // JSON array string e.g. ["Web Development", "AI/ML"]
  preferredMode      String?  @default("ANY") // REMOTE, HYBRID, ON_SITE, ANY
  preferredLocations String?  // JSON array string e.g. ["Pune", "Bangalore"]
  profileStatus      String   @default("DRAFT") // DRAFT, SUBMITTED, UNDER_REVIEW, VERIFIED, REJECTED, CORRECTION_REQUIRED
  verificationRemark String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  skills            StudentSkill[]
  certifications    Certification[]
  projects          Project[]
  experiences       Experience[]
  applications      Application[]
  mentorAssignments MentorAssignment[]
  progressReports   ProgressReport[]
  issues            Issue[]
  evaluations       Evaluation[]
  completions       Completion[]
  ppos              PPO[]

  @@index([department])
  @@index([profileStatus])
  @@index([passingYear])
}

model StudentSkill {
  id          String         @id @default(uuid())
  studentId   String
  student     StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  skillName   String
  proficiency String?        // BEGINNER, INTERMEDIATE, ADVANCED
  evidence    String?

  @@index([studentId])
  @@index([skillName])
}

model Certification {
  id         String         @id @default(uuid())
  studentId  String
  student    StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  name       String
  issuer     String
  issueDate  String?
  expiryDate String?
  documentId String?

  @@index([studentId])
}

model Project {
  id           String         @id @default(uuid())
  studentId    String
  student      StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  title        String
  description  String
  technologies String         // JSON string or CSV
  projectUrl   String?

  @@index([studentId])
}

model Experience {
  id          String         @id @default(uuid())
  studentId   String
  student     StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  company     String
  role        String
  description String?
  startDate   String?
  endDate     String?
  isCurrent   Boolean        @default(false)
  location    String?

  @@index([studentId])
}

model CompanyProfile {
  id                 String   @id @default(uuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name               String
  website            String?
  industry           String?
  description        String?
  location           String?
  phone              String?
  contactName        String
  contactEmail       String
  verificationStatus String   @default("VERIFIED") // PENDING, VERIFIED, REJECTED
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  internships Internship[]
  ppos        PPO[]

  @@index([verificationStatus])
}

model MentorProfile {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName    String
  department  String
  designation String
  maxCapacity Int      @default(10)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assignments     MentorAssignment[]
  progressReports ProgressReport[]
  issues          Issue[]
  evaluations     Evaluation[]

  @@index([department])
}

model Internship {
  id                 String         @id @default(uuid())
  companyId          String
  company            CompanyProfile @relation(fields: [companyId], references: [id], onDelete: Cascade)
  title              String
  description        String
  durationMonths     Int
  mode               String         @default("ON_SITE") // REMOTE, HYBRID, ON_SITE
  location           String
  stipend            Float
  vacancies          Int
  deadline           String
  startDate          String?
  status             String         @default("OPEN") // DRAFT, PUBLISHED, OPEN, PAUSED, CLOSED, ARCHIVED
  minCgpa            Float          @default(0.0)
  maxBacklogs        Int            @default(0)
  allowedBranches    String         // JSON array string e.g. ["CSE","IT"]
  passingYears       String         // JSON array string e.g. [2026, 2027]
  requiredSkills     String         // JSON array string e.g. ["Java","SQL"]
  requiredExperience Int            @default(0)
  responsibilities   String?
  requirements       String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  applications      Application[]
  mentorAssignments MentorAssignment[]
  progressReports   ProgressReport[]
  issues            Issue[]
  evaluations       Evaluation[]
  completions       Completion[]
  ppos              PPO[]

  @@index([companyId])
  @@index([status])
  @@index([mode])
  @@index([createdAt])
}

model Application {
  id               String         @id @default(uuid())
  internshipId     String
  internship       Internship     @relation(fields: [internshipId], references: [id], onDelete: Cascade)
  studentId        String
  student          StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status           String         @default("APPLIED") // APPLIED, UNDER_REVIEW, SHORTLISTED, SELECTED, REJECTED, WITHDRAWN
  appliedAt        DateTime       @default(now())
  withdrawnAt      DateTime?
  eligibilityScore Float          @default(100.0)
  aiMatchScore     Float          @default(0.0)
  matchExplanation String?

  offer Offer?

  @@unique([internshipId, studentId])
  @@index([internshipId])
  @@index([studentId])
  @@index([status])
  @@index([appliedAt])
}

model Offer {
  id                 String      @id @default(uuid())
  applicationId      String      @unique
  application        Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  role               String?
  startDate          String?
  endDate            String?
  stipend            Float?
  location           String?
  terms              String?
  documentId         String?
  issuedAt           DateTime    @default(now())
  acceptanceDeadline String?
  studentResponse    String      @default("PENDING") // PENDING, ACCEPTED, DECLINED
  status             String      @default("ISSUED")  // DRAFT, ISSUED, ACCEPTED, TNP_REVIEW, APPROVED, REJECTED, CORRECTION_REQUIRED
  verificationCode   String      @unique @default(uuid())
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  @@index([applicationId])
  @@index([status])
}

model Verification {
  id         String    @id @default(uuid())
  entityType String    // PROFILE, OFFER, COMPLETION, DOCUMENT, PPO
  entityId   String
  verifierId String?
  status     String    @default("PENDING") // PENDING, APPROVED, REJECTED, CORRECTION_REQUIRED
  reason     String?
  reviewedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([entityType, entityId])
  @@index([status])
  @@index([verifierId])
}

model MentorAssignment {
  id           String         @id @default(uuid())
  studentId    String
  student      StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  internshipId String
  internship   Internship     @relation(fields: [internshipId], references: [id], onDelete: Cascade)
  mentorId     String
  mentor       MentorProfile  @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  assignedBy   String
  status       String         @default("ASSIGNED") // ASSIGNED, ACCEPTED, REJECTED, REASSIGNED, ACTIVE, COMPLETED
  assignedAt   DateTime       @default(now())
  acceptedAt   DateTime?
  rejectedAt   DateTime?
  reassignedAt DateTime?
  remarks      String?

  @@index([mentorId])
  @@index([studentId])
  @@index([internshipId])
  @@index([status])
}

model ProgressReport {
  id                     String         @id @default(uuid())
  internshipId           String
  internship             Internship     @relation(fields: [internshipId], references: [id], onDelete: Cascade)
  studentId              String
  student                StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  mentorId               String?
  mentor                 MentorProfile? @relation(fields: [mentorId], references: [id], onDelete: SetNull)
  weekNumber             Int
  startDate              String?
  endDate                String?
  tasks                  String
  learning               String
  challenges             String
  hours                  Float          @default(40.0)
  documentId             String?
  status                 String         @default("SUBMITTED") // SUBMITTED, APPROVED, CHANGES_REQUIRED
  feedback               String?
  reviewedAt             DateTime?
  taskVerificationStatus String?        @default("PENDING") // PENDING, VERIFIED, NEEDS_REVISION
  companyFeedback        String?
  companyReviewedAt      DateTime?
  submittedAt            DateTime       @default(now())
  updatedAt              DateTime       @default(now()) @updatedAt

  @@index([internshipId])
  @@index([studentId])
  @@index([mentorId])
  @@index([status])
  @@index([weekNumber])
}

model Issue {
  id           String          @id @default(uuid())
  internshipId String
  internship   Internship      @relation(fields: [internshipId], references: [id], onDelete: Cascade)
  studentId    String
  student      StudentProfile  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  mentorId     String?
  mentor       MentorProfile?  @relation(fields: [mentorId], references: [id], onDelete: SetNull)
  raisedBy     String?
  priority     String          @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  severity     String          @default("NEEDS_ATTENTION") // ON_TRACK, NEEDS_ATTENTION, CRITICAL
  title        String
  description  String
  assignedTo   String?
  status       String          @default("OPEN") // OPEN, IN_PROGRESS, RESOLVED, CLOSED
  resolution   String?
  resolvedAt   DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @default(now()) @updatedAt

  @@index([internshipId])
  @@index([studentId])
  @@index([mentorId])
  @@index([status])
  @@index([priority])
}

model Evaluation {
  id                   String         @id @default(uuid())
  internshipId         String
  internship           Internship     @relation(fields: [internshipId], references: [id], onDelete: Cascade)
  studentId            String
  student              StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  evaluatorId          String
  evaluatorRole        String         // MENTOR, COMPANY
  technicalScore       Float
  problemSolvingScore  Float
  communicationScore   Float
  professionalismScore Float
  teamworkScore        Float
  disciplineScore      Float          @default(8.0)
  taskCompletionScore  Float          @default(8.0)
  overallScore         Float
  comments             String?
  feedbackSummary      String?
  criteriaBreakdown    String?
  submittedAt          DateTime       @default(now())
  updatedAt            DateTime       @default(now()) @updatedAt
  mentorProfileId      String?
  mentor               MentorProfile? @relation(fields: [mentorProfileId], references: [id])

  @@index([internshipId])
  @@index([studentId])
  @@index([evaluatorRole])
}

model Document {
  id           String   @id @default(uuid())
  ownerUserId  String
  owner        User     @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  entityType   String
  entityId     String
  documentType String   // COLLEGE_ID, ACADEMIC_RECORD, RESUME, CERTIFICATION, OFFER_LETTER, COMPLETION_CERTIFICATE, PPO_LETTER
  storageKey   String
  originalName String
  mimeType     String
  size         Int
  status       String   @default("UPLOADED") // UPLOADED, UNDER_REVIEW, VERIFIED, REJECTED, CORRECTION_REQUIRED
  uploadedAt   DateTime @default(now())

  @@index([ownerUserId])
  @@index([entityType, entityId])
  @@index([documentType])
}

model Completion {
  id                    String         @id @default(uuid())
  internshipId          String
  internship            Internship     @relation(fields: [internshipId], references: [id], onDelete: Cascade)
  studentId             String
  student               StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  certificateId         String?        @unique
  verificationCode      String?        @unique
  certificateDocumentId String?
  recommendedBy         String?        // MENTOR, COMPANY
  recommendationRemarks String?
  rejectionReason       String?
  finalScore            Float?
  grade                 String?
  verifiedBy            String?        // T&P Officer user ID
  verifiedAt            DateTime?
  completionDate        DateTime?
  status                String         @default("RECOMMENDED") // RECOMMENDED, PENDING, APPROVED, REJECTED
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @default(now()) @updatedAt

  @@index([internshipId])
  @@index([studentId])
  @@index([status])
}

model PPO {
  id                  String         @id @default(uuid())
  internshipId        String
  internship          Internship     @relation(fields: [internshipId], references: [id], onDelete: Cascade)
  studentId           String
  student             StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  companyId           String
  company             CompanyProfile @relation(fields: [companyId], references: [id], onDelete: Cascade)
  status              String         @default("UNDER_CONSIDERATION") // NOT_OFFERED, UNDER_CONSIDERATION, OFFERED, DECLINED, ACCEPTED
  role                String?
  offeredCtc          Float?
  offerDate           String?
  joiningDate         String?
  location            String?
  terms               String?
  documentId          String?
  isVerified          Boolean        @default(false)
  verifiedBy          String?        // T&P Officer user ID
  verifiedAt          DateTime?
  verificationRemarks String?
  studentResponseDate DateTime?
  studentRemarks      String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @default(now()) @updatedAt

  @@index([internshipId])
  @@index([studentId])
  @@index([companyId])
  @@index([status])
}

model Notification {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String    // REGISTRATION, VERIFICATION, ELIGIBILITY, APPLICATION, SHORTLIST, SELECTION, OFFER, TNP_APPROVAL, MENTOR_ASSIGNMENT, WEEKLY_REPORT, FEEDBACK, ISSUE, EVALUATION, COMPLETION, CERTIFICATE, PPO
  title     String
  message   String
  dataJson  String?
  channel   String    @default("IN_APP") // IN_APP, EMAIL, SMS, PUSH
  isRead    Boolean   @default(false)
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}

model AuditLog {
  id          String   @id @default(uuid())
  actorId     String
  actor       User     @relation(fields: [actorId], references: [id], onDelete: Cascade)
  action      String
  entityType  String
  entityId    String
  oldDataJson String?
  newDataJson String?
  reason      String?
  createdAt   DateTime @default(now())

  @@index([actorId])
  @@index([action])
  @@index([entityType])
  @@index([createdAt])
}
