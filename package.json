{
  "name": "internship-management-system-root",
  "version": "1.0.0",
  "private": true,
  "description": "AI-Powered Internship Management System Monorepo Root",
  "scripts": {
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "build:backend": "cd backend && npm run build",
    "build:frontend": "cd frontend && npm run build",
    "build": "npm run build:backend && npm run build:frontend",
    "test:backend": "cd backend && npm test",
    "test:root": "jest",
    "test": "npm run test:backend && npm run test:root",
    "db:push": "cd backend && npm run prisma:push",
    "db:seed": "cd backend && npm run prisma:seed"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "typescript": "^5.3.3"
  }
}
